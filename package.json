{
  "name": "careconnect-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test",
    "test:all": "npm --prefix backend run test && npm --prefix frontend run test",
    "test:auth": "npm --prefix backend run test:auth",
    "test:medication": "npm --prefix backend run test:medication",
    "test:appointment": "npm --prefix backend run test:appointment",
    "test:profile": "npm --prefix backend run test:profile",
    "test:notifications": "npm --prefix backend run test:notifications",
    "test:security": "npm --prefix backend run test:security",
    "test:qa": "npm --prefix backend run test:qa",
    "worker": "npm --prefix backend run worker",
    "seed": "npm --prefix backend run seed",
    "seed:health": "npm --prefix backend run seed:health",
    "seed:doctors": "npm --prefix backend run seed:doctors",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
