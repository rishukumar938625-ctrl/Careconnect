# CareConnect Environment Configuration Template
# Backend: Copy to backend/.env (or root .env)
# Frontend: Copy to frontend/.env
# Do NOT commit actual .env files to source control.

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection
# Replace <db_username> and <db_password> with your Atlas database user credentials
# Note: If password contains special characters (e.g. @, #, $, %), URL-encode them (e.g. @ -> %40, $ -> %24)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.usdcl3x.mongodb.net/careconnect?retryWrites=true&w=majority&appName=Cluster0

# Phase 3 Authentication Secret (placeholder)
JWT_SECRET=your_jwt_secret_key_here

# Frontend API URL
VITE_API_URL=http://localhost:5000/api

# Phase 7: Background Notification Worker Configuration
# Set to 'true' to run the worker embedded in the API server, or 'false' to run standalone via 'npm run worker'
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
WORKER_LEASE_DURATION_MS=60000

# Phase 7: Email Delivery Provider Configuration
# Set to 'simulated' for local development & testing, or 'smtp' for real SMTP credentials
EMAIL_PROVIDER=simulated
FROM_EMAIL=notifications@careconnect.app
# SMTP Configuration (only required if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
