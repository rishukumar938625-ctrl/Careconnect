# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection
# Replace <db_username> and <db_password> with your Atlas database user credentials
# Note: If your password contains special characters (like @, #, $, %), URL-encode them (e.g. @ -> %40, $ -> %24)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.usdcl3x.mongodb.net/careconnect?retryWrites=true&w=majority&appName=Cluster0

# Phase 2 Authentication Secret (placeholder)
JWT_SECRET=your_jwt_secret_key_here
