# CareConnect Backend — Environment Configuration Template
# Copy this file to backend/.env and fill in your actual values.
# NEVER commit an actual .env file to source control.
# All values marked [REQUIRED in prod] must be set before deploying to production.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development           # development | production | test

# The publicly reachable URL of your deployed frontend (no trailing slash).
# [REQUIRED in prod] Must match the exact origin browsers will send in CORS headers.
FRONTEND_URL=http://localhost:5173

# Trust reverse proxy X-Forwarded-* headers.
# Set to true on Render / Railway / Heroku / AWS ELB (any proxy-fronted deployment).
TRUST_PROXY=false

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string.  [REQUIRED in prod]
# Encode special characters in the password (%40 for @, %24 for $, etc.)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.usdcl3x.mongodb.net/careconnect?retryWrites=true&w=majority&appName=Cluster0

# ─── Authentication ───────────────────────────────────────────────────────────
# JWT signing secret.  [REQUIRED in prod]  Minimum 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars

# ─── Cookie Settings ──────────────────────────────────────────────────────────
# strict (recommended for same-site apps) | lax | none (cross-site; requires HTTPS)
COOKIE_SAME_SITE=strict

# Set to true when the app is served over HTTPS (always true in production).
COOKIE_SECURE=false

# (Optional) Scope cookies to a specific domain, e.g. .careconnect.app
# COOKIE_DOMAIN=

# ─── Background Notification Worker ──────────────────────────────────────────
# Set to true to run the notification worker inside this process.
# In production, prefer running backend/src/worker.ts as a separate process/dyno.
WORKER_ENABLED=false

# How often the worker polls for pending notification jobs (milliseconds).
WORKER_POLL_INTERVAL_MS=5000

# Maximum notification jobs processed per poll cycle.
WORKER_BATCH_SIZE=10

# How long a worker holds a job lease before it is considered abandoned (milliseconds).
WORKER_LEASE_DURATION_MS=60000

# ─── Email / Notifications ────────────────────────────────────────────────────
# simulated (logs to console) | smtp (real email delivery)
EMAIL_PROVIDER=simulated

# Sender address shown to recipients.
FROM_EMAIL=notifications@careconnect.app

# Required when EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false    # true for port 465 (TLS), false for 587 (STARTTLS)
